JWT_SECRET=replace-this-with-a-random-strong-secret-at-least-32-characters
PORT=3000
CORS_ORIGIN=http://localhost:8081
REPORTING_URL=http://localhost:5100
REPORTING_SERVICE_TOKEN=replace-this-with-another-random-long-token
